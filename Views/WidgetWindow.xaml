<!-- Views/WidgetWindow.xaml -->
<Window x:Class="FxVolatilityImport.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FxVolatilityImport.Converters"
        Title="FX Vol Widget"
        Height="176" Width="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <conv:LevelToBrushConverter x:Key="LevelBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Används från code-behind -->
        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <Storyboard x:Key="SuccessFadeOut">
            <DoubleAnimation Storyboard.TargetName="SuccessIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:3" BeginTime="0:0:2"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#F2101828" CornerRadius="12" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Rubrik -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource Brush.AccentGradient}">
                        <Path Width="11" Height="8" Stretch="Fill" Data="M0,8 L4,3 L7,5 L11,0"
                              Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                    </Border>
                    <TextBlock Text="FX Volatility" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Ghost}" Padding="6,2"
                        Click="CloseButton_Click" ToolTip="Open main window">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" StrokeThickness="1.2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

            <!-- Status: Bloomberg + scheduler -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding BloombergDetail}">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding BloombergLevel, Converter={StaticResource LevelBrush}}"/>
                    <TextBlock Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                               Text="{Binding BloombergText}"
                               Foreground="{Binding BloombergLevel, Converter={StaticResource LevelBrush}}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" FontSize="11.5" VerticalAlignment="Center"
                           ToolTip="{Binding SchedulerDetail}"
                           Foreground="{Binding SchedulerLevel, Converter={StaticResource LevelBrush}}">
                    <Run Text="Next"/>
                    <Run Text="{Binding NextScheduledText, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="·"/>
                    <Run Text="{Binding SchedulerText, Mode=OneWay}"/>
                </TextBlock>
            </Grid>

            <!-- Ad hoc-import -->
            <Button Grid.Row="2" Margin="0,10" Style="{StaticResource Btn.Primary}" Padding="12,6"
                    Command="{Binding LoadAndImportCommand}"
                    ToolTip="Load from Bloomberg and import ATM + smile to MX3">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M6,0 L1,7 H5 L4,12 L9.5,4.5 H5.5 Z" VerticalAlignment="Center" Fill="White"/>
                    <TextBlock Text="Load &amp; import all" Margin="7,0,0,0"/>
                    <TextBlock Margin="6,0,0,0" Foreground="#CCFFFFFF" FontWeight="Normal">
                        <Run Text="("/><Run Text="{Binding CurrencyPairs.Count, Mode=OneWay}"/><Run Text=" pairs)"/>
                    </TextBlock>
                </StackPanel>
            </Button>

            <!-- Statusrad med importindikator -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Inset}" CornerRadius="7" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Vila -->
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.TextFaint}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ImportJustCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Import pågår -->
                        <Grid Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                            <Ellipse Stroke="{StaticResource Level.Warning.Fg}" StrokeThickness="2" Opacity="0.25"/>
                            <Ellipse Stroke="{StaticResource Level.Warning.Fg}" StrokeThickness="2"
                                     StrokeDashArray="6 30" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <!-- Klart -->
                        <Grid x:Name="SuccessIndicator" Opacity="0"
                              Visibility="{Binding ImportJustCompleted, Converter={StaticResource BoolToVis}}">
                            <Ellipse Fill="{StaticResource Level.Good.Fg}"/>
                            <Path Data="M3.5,8 L6.5,11 L12,5" Stroke="{StaticResource Brush.Bg}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Text="{Binding StatusText}" ToolTip="{Binding StatusText}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>